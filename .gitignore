# ── 本地缓存 (从 git 跟踪的 CSV 派生, 后端按需重建, 不进 git) ──
# 注意: gitignore 不支持行内注释, 规则必须独占一行
1d/
snapshot/
market/

# ── git 跟踪的权威数据均为 CSV ──
# daily/<symbol>.csv          个股日线
# index/<code>.csv            多市场指数时间序列
# fundamental/<表>/<期>.csv    财报
# macro/*.csv                 宏观
# meta/*.csv                  基础信息

# Python
__pycache__/
*.pyc
.DS_Store

# Pipeline artifacts (local only)
logs/
